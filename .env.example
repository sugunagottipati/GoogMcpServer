GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/oauth2/callback
GOOGLE_TOKEN_STORE_PATH=.google-tokens.json
# Alternative to GOOGLE_TOKEN_STORE_PATH for deployments without a persistent volume (e.g. Railway):
# set this to the encrypted payload printed by `npm run authorize` instead.
# GOOGLE_TOKENS_JSON={"iv":"...","tag":"...","ciphertext":"..."}
GOOGLE_TOKEN_STORE_ENCRYPTION_KEY=base64-encoded-32-byte-key
LOG_LEVEL=info
TRANSPORT=stdio
PORT=3000
MAX_EMAIL_SUBJECT_SIZE=998
MAX_EMAIL_BODY_SIZE=1048576
MAX_DOCUMENT_APPEND_SIZE=1048576
REQUEST_TIMEOUT_MS=15000
RATE_LIMIT_PER_MINUTE=30
IDEMPOTENCY_TTL_SECONDS=86400